<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.VitaFlow" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash theme for devices below Android 12 -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.VitaFlow</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/animated_logo</item>
        <!-- Icon background for older devices -->
        <item name="windowSplashScreenIconBackgroundColor">@color/white</item>
    </style>
</resources>
